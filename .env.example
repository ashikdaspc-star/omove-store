# Razorpay Payment Gateway Credentials
# Key ID (Public, used on frontend checkout modal)
VITE_RAZORPAY_KEY_ID="rzp_test_YourKeyIdHere"

# Key Secret (Private, used strictly on backend server)
RAZORPAY_KEY_SECRET="YourRazorpayKeySecretHere"

# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="https://www.omovestore.shop"

# GITHUB_TOKEN: Personal Access Token (PAT) with repo scope for automated GitHub main commits
# Set this in Vercel Environment Variables to enable server-side direct GitHub commits
GITHUB_TOKEN="ghp_YourGitHubPersonalAccessTokenHere"
VITE_GITHUB_TOKEN="ghp_YourGitHubPersonalAccessTokenHere"

# PayPal Checkout Payment Gateway
# Client ID (used on frontend via /api/paypal/config endpoint)
PAYPAL_CLIENT_ID="YOUR_PAYPAL_CLIENT_ID_HERE"
# Client Secret (Private, used strictly on backend server - NEVER expose to frontend)
PAYPAL_CLIENT_SECRET="YOUR_PAYPAL_CLIENT_SECRET_HERE"
# Mode / Environment: 'sandbox' for testing, 'live' for production
PAYPAL_ENV="live"
PAYPAL_MODE="live"

# Google OAuth 2.0 Credentials
# Client ID (Public identifier used on frontend and server token validation)
GOOGLE_CLIENT_ID="596954865902-rn605o42bjk3a013i345o2k3gn0qfcjt.apps.googleusercontent.com"
VITE_GOOGLE_CLIENT_ID="596954865902-rn605o42bjk3a013i345o2k3gn0qfcjt.apps.googleusercontent.com"
# Client Secret (Private, server-side only - NEVER expose to frontend or git)
GOOGLE_CLIENT_SECRET="YOUR_GOOGLE_CLIENT_SECRET_HERE"
